# Ignore local dependencies, as they will be installed inside the container

node_modules
bun.lockb

# Ignore logs

npm-debug.log
yarn-error.log

# Ignore environment files, as secrets should be passed in during runtime

.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ignore version control and documentation

.git
.gitignore
README.md

# Ignore Docker files themselves

Dockerfile
docker-compose.yml

# Ignore IDE and OS-specific files

.vscode
.idea
.DS_Store
